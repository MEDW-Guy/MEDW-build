local Params=RaycastParams.new()
Params.FilterType=Enum.RaycastFilterType.Exclude
local function refreshFilter()
    local ex={HandlesFolder}
    if LP.Character then table.insert(ex,LP.Character) end
    Params.FilterDescendantsInstances=ex
end
refreshFilter()
LP.CharacterAdded:Connect(function()
    task.wait(0.5)
    refreshFilter()
end)

local HandleFilter=RaycastParams.new()
HandleFilter.FilterType=Enum.RaycastFilterType.Include
HandleFilter.FilterDescendantsInstances={HandlesFolder}

local function snap(v)
    if not State.Snap then return v end
    return math.floor(v/State.Grid+0.5)*State.Grid
end

local function rayAt(x,y)
    local ray=Camera:ViewportPointToRay(x,y)
    return workspace:Raycast(ray.Origin,ray.Direction*2000,Params)
end
local function rayFree(x,y) return Camera:ViewportPointToRay(x,y) end
local function rayHandle(x,y)
    local ray=Camera:ViewportPointToRay(x,y)
    return workspace:Raycast(ray.Origin,ray.Direction*2000,HandleFilter)
end

