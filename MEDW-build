-- ==========================================
-- Handles
-- ==========================================

local handles={}

local function clearHandles()
    for _,h in ipairs(handles) do
        if h.part and h.part.Parent then h.part:Destroy() end
    end
    handles={}
end

local HANDLE_SIZE=0.75

local function buildHandles(src)
    clearHandles()
    if not src or not src.Parent then return end
    local s=src.Size
    local hs=HANDLE_SIZE
    local axes={
        {Vector3.new(1,0,0),Color3.fromRGB(235,80,80)},
        {Vector3.new(-1,0,0),Color3.fromRGB(235,80,80)},
        {Vector3.new(0,1,0),Color3.fromRGB(70,220,90)},
        {Vector3.new(0,-1,0),Color3.fromRGB(70,220,90)},
        {Vector3.new(0,0,1),Color3.fromRGB(70,130,240)},
        {Vector3.new(0,0,-1),Color3.fromRGB(70,130,240)},
    }
    for i,d in ipairs(axes) do
        local axis=d[1]
        local h=Instance.new("Part")
        h.Shape=Enum.PartType.Ball
        h.Size=Vector3.new(hs,hs,hs)
        h.Anchored=true
        h.CanCollide=false
        h.CanQuery=true
        h.Material=Enum.Material.Neon
        h.Color=d[2]
        h.Transparency=0
        h.Name="RSH_"..i
        local offset=Vector3.new(
            axis.X*(s.X/2),
            axis.Y*(s.Y/2),
            axis.Z*(s.Z/2)
        )
        h.CFrame=src.CFrame*CFrame.new(offset)
        h.Parent=HandlesFolder
        table.insert(handles,{part=h,axis=axis,src=src})
    end
end

local function updateHandlePositions(src)
    if not src or not src.Parent then return end
    local s=src.Size
    local hs=HANDLE_SIZE
    for _,h in ipairs(handles) do
        local axis=h.axis
        local offset=Vector3.new(
            axis.X*(s.X/2),
            axis.Y*(s.Y/2),
            axis.Z*(s.Z/2)
        )
        h.part.CFrame=src.CFrame*CFrame.new(offset)
    end
end

-- ==========================================
-- Operations
-- ==========================================

local function createPart(shape,cf)
    local p
    if shape=="Wedge" then
        p=Instance.new("WedgePart")
        p.Size=Vector3.new(4,2,2)
    else
        p=Instance.new("Part")
        p.Size=Vector3.new(4,1,2)
        if shape=="Ball" then
            p.Shape=Enum.PartType.Ball
            p.Size=Vector3.new(2,2,2)
        elseif shape=="Cylinder" then
            p.Shape=Enum.PartType.Cylinder
            p.Size=Vector3.new(2,2,2)
        end
    end
    p.Anchored=true
    p.CanCollide=true
    p.Material=Enum.Material.Plastic
    p.Color=Color3.fromRGB(163,162,165)
    p.CFrame=cf
    p.Name="Part"
    p.Parent=Parts
    return p
end

local function select(part)
    State.Selected=part
    SelBox.Adornee=part
    if _G.BuildRefreshProps then _G.BuildRefreshProps() end
    if State.Mode=="resize" then buildHandles(part) end
end

local function deselect()
    State.Selected=nil
    SelBox.Adornee=nil
    clearHandles()
    if _G.BuildRefreshProps then _G.BuildRefreshProps() end
end

-- ==========================================
-- Input
-- ==========================================

local dragState=nil
local resizeDrag=nil

local function isOurPart(inst)
    return inst and inst:IsDescendantOf(Parts)
end

local function handleClick(x,y)
    local res=rayAt(x,y)
    local mode=State.Mode

    if mode=="create" then
        local cf
        if res then
            local n=res.Normal
            local base=Vector3.new(2,0.5,1)
            if State.Shape=="Ball" or State.Shape=="Cylinder" then base=Vector3.new(1,1,1) end
            if State.Shape=="Wedge" then base=Vector3.new(2,1,1) end
            local off=Vector3.new(base.X*math.abs(n.X),base.Y*math.abs(n.Y),base.Z*math.abs(n.Z))
            local pos=res.Position+off
            cf=CFrame.new(snap(pos.X),snap(pos.Y),snap(pos.Z))
        else
            local ray=rayFree(x,y)
            local pos=ray.Origin+ray.Direction*50
            cf=CFrame.new(snap(pos.X),snap(pos.Y),snap(pos.Z))
        end
        select(createPart(State.Shape,cf))
    elseif mode=="select" then
        if res and isOurPart(res.Instance) then
            select(res.Instance)
        else
            deselect()
        end
    elseif mode=="delete" then
        if res and isOurPart(res.Instance) then
            if State.Selected==res.Instance then deselect() end
            res.Instance:Destroy()
        end
    elseif mode=="clone" then
        if res and isOurPart(res.Instance) then
            local src=res.Instance
            local c=src:Clone()
            c.CFrame=src.CFrame*CFrame.new(src.Size.X+1,0,0)
            c.Parent=Parts
            select(c)
        end
    end
    -- mode "move" and "resize": clicks don't change selection
end

local function startDrag(x,y)
    if State.Mode=="move" and State.Selected then
        local startPos=State.Selected.Position
        local ray=rayFree(x,y)
        if math.abs(ray.Direction.Y)>0.0001 then
            local t=(startPos.Y-ray.Origin.Y)/ray.Direction.Y
            if t>0 then
                dragState={part=State.Selected,startPos=startPos,startHit=ray.Origin+ray.Direction*t}
            end
        end
    elseif State.Mode=="resize" and State.Selected then
        local hres=rayHandle(x,y)
        if hres and hres.Instance then
            for _,h in ipairs(handles) do
                if h.part==hres.Instance then
                    local src=h.src
                    local axis=h.axis
                    local axisWorld=src.CFrame:VectorToWorldSpace(axis)
                    local fixedWorld=(src.CFrame*CFrame.new(-axis*(src.Size*0.5))).Position
                    resizeDrag={
                        src=src,
                        axis=axis,
                        axisWorld=axisWorld,
                        fixed=fixedWorld,
                        startSize=src.Size,
                    }
                    return
                end
            end
        end
    end
end

local function updateDrag(x,y)
    if dragState then
        local part=dragState.part
        if not part or not part.Parent then dragState=nil return end
        local ray=rayFree(x,y)
        if math.abs(ray.Direction.Y)>0.0001 then
            local t=(dragState.startHit.Y-ray.Origin.Y)/ray.Direction.Y
            if t>0 then
                local hit=ray.Origin+ray.Direction*t
                local np=dragState.startPos+(hit-dragState.startHit)
                part.Position=Vector3.new(snap(np.X),snap(np.Y),snap(np.Z))
                if State.Mode=="resize" then updateHandlePositions(part) end
            end
        end
    elseif resizeDrag then
        local src=resizeDrag.src
        if not src or not src.Parent then resizeDrag=nil return end
        local ray=rayFree(x,y)

        local p1=ray.Origin
        local d1=ray.Direction
        local p2=resizeDrag.fixed
        local d2=resizeDrag.axisWorld

        local a1=d1:Dot(d1)
        local b1=d1:Dot(d2)
        local c1=d2:Dot(d2)
        local diff=p1-p2
        local e1=d1:Dot(diff)
        local f1=d2:Dot(diff)
        local denom=a1*c1-b1*b1
        if math.abs(denom)>1e-6 then
            local tOnAxis=(a1*f1-b1*e1)/denom
            local closest=p2+d2*tOnAxis
            local diffAxis=closest-p2
            local newLength=diffAxis:Dot(d2)
            newLength=math.max(0.05,newLength)
            if newLength>500 then newLength=500 end
            newLength=snap(newLength)

            local sz=resizeDrag.startSize
            local nx,ny,nz=sz.X,sz.Y,sz.Z
            if math.abs(resizeDrag.axis.X)>0.5 then nx=newLength
            elseif math.abs(resizeDrag.axis.Y)>0.5 then ny=newLength
            elseif math.abs(resizeDrag.axis.Z)>0.5 then nz=newLength end
            src.Size=Vector3.new(nx,ny,nz)

            local rotOnly=src.CFrame - src.CFrame.Position
            local newCenter=p2+d2*(newLength/2)
            src.CFrame=CFrame.new(newCenter)*rotOnly
            updateHandlePositions(src)
        end
    end
end

