local function overMenu()
    local mp=UIS:GetMouseLocation()
    local ap=MF.AbsolutePosition
    local as=MF.AbsoluteSize
    return mp.X>=ap.X and mp.X<=ap.X+as.X and mp.Y>=ap.Y and mp.Y<=ap.Y+as.Y
end

UIS.InputBegan:Connect(function(inp,gp)
    if gp then return end
    if inp.UserInputType==Enum.UserInputType.MouseButton1 then
        if overMenu() then return end
        if UIS:GetFocusedTextBox() then return end
        local mp=UIS:GetMouseLocation()
        -- resize handles take priority
        if State.Mode=="resize" then
            local hres=rayHandle(mp.X,mp.Y)
            if hres and hres.Instance then
                startDrag(mp.X,mp.Y)
                return
            end
        end
        handleClick(mp.X,mp.Y)
        startDrag(mp.X,mp.Y)
    elseif inp.KeyCode==Enum.KeyCode.B then
        if not UIS:GetFocusedTextBox() then
            MF.Visible=not MF.Visible
        end
    elseif inp.KeyCode==Enum.KeyCode.Delete then
        if State.Selected then
            State.Selected:Destroy()
            deselect()
        end
    elseif inp.KeyCode==Enum.KeyCode.Escape then
        deselect()
    elseif inp.KeyCode==Enum.KeyCode.D and UIS:IsKeyDown(Enum.KeyCode.LeftControl) then
        if State.Selected then
            local c=State.Selected:Clone()
            c.CFrame=State.Selected.CFrame*CFrame.new(State.Selected.Size.X+1,0,0)
            c.Parent=Parts
            select(c)
        end
    end
end)

UIS.InputChanged:Connect(function(inp)
    if inp.UserInputType~=Enum.UserInputType.MouseMovement then return end
    if dragState or resizeDrag then
        local mp=UIS:GetMouseLocation()
        updateDrag(mp.X,mp.Y)
    end
end)

UIS.InputEnded:Connect(function(inp)
    if inp.UserInputType==Enum.UserInputType.MouseButton1 then
        dragState=nil
        resizeDrag=nil
    end
end)

